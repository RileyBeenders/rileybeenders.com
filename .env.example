# Copy to .env.local (git-ignored). Only the contact form needs any of these;
# without them the site builds and runs, and the form falls back to the
# visitor's own mail app.

# Resend (https://resend.com): the API key for the verified sending domain.
RESEND_API_KEY=

# The one inbox every message from the site lands in.
CONTACT_TO=contact@rileybeenders.com

# The verified sender shown on each message. Must be on a domain Resend has verified.
CONTACT_FROM="RileyBeenders.com <contact@rileybeenders.com>"
