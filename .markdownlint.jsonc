{
  // Prose is written as long lines and soft-wrapped by the editor.
  "MD013": false,

  // DESIGN.md is generated by `impeccable document` in the Stitch DESIGN.md format, which
  // repeats "### Named Rules" under several sections and opens with a bold "Creative North
  // Star" line rather than a heading. Hand-editing it would be undone on the next regenerate.
  "MD024": { "siblings_only": true },
  "MD036": false,

  // Its YAML front matter has a typography role literally named `title:`. The default
  // front-matter-title regex matches that token and then reports the real H1 as a duplicate.
  "MD025": { "front_matter_title": "" }
}
