{
  "_doc": "Routing data for skill-router. One entry per folder in .claude/skills/. phase: 1 ground, 2 decide, 3 build, 4 verify, 5 ship/sync. gate 'explicit' = suppressed unless the prompt names the skill or one of its keywords (it conflicts with a repo rule, see note). keywords: phrases/words the prompt is matched against (word-boundary, case-insensitive). Run `node .claude/skills/skill-router/scripts/route.mjs --check` after adding or removing a skill.",
  "skills": {
    "skill-router": { "group": "meta", "phase": 1, "keywords": ["which skill", "what skill", "route this", "skill router", "load balancer"], "summary": "Picks skills for a request." },

    "custom-resume": { "group": "resume", "phase": 3, "keywords": ["resume", "tailor", "job posting", "job pdf", "JobsApplliedTo", "application for"], "next": ["grill-my-resume"], "summary": "Build a job-targeted resume PDF." },
    "grill-my-resume": { "group": "resume", "phase": 4, "keywords": ["grill my resume", "roast", "audit my resume", "ats", "review my resume", "critique my resume", "resume feedback"], "next": ["fix-my-resume"], "note": "Review only. Never edits. Findings go to fix-my-resume.", "summary": "Blunt resume review." },
    "fix-my-resume": { "group": "resume", "phase": 3, "keywords": ["fix my resume", "apply the review", "apply the grill", "clean up resume", "recruiter notes", "roast report"], "note": "No repeated claims, no invented numbers, ignore 'recent graduate' advice.", "summary": "Apply a resume review and reprint." },

    "vault-sync": { "group": "repo-sync", "phase": 5, "keywords": ["vault", "obsidian", "sync the vault", "documentation vault"], "summary": "Keep the Obsidian vault matching repo changes." },
    "sync-charts": { "group": "repo-sync", "phase": 5, "keywords": ["gantt", "job tracker", "application tracker", "mermaid", "jobid", "sync charts", "tracker file"], "summary": "Reconcile README and gantt.md." },
    "site-timeline-sync": { "group": "repo-sync", "phase": 5, "keywords": ["site timeline", "about page", "about this site", "site stats", "timeline entry", "about-site"], "summary": "Maintain data/site/about-site.json." },

    "impeccable": { "group": "design-core", "phase": 3, "keywords": ["design", "redesign", "critique", "audit", "polish", "typeset", "typography", "layout", "spacing", "colorize", "color", "harden", "distill", "quieter", "bolder", "delight", "onboard", "empty state", "ui", "interface", "component", "accessibility", "responsive", "make it look", "looks off", "extract tokens", "design system"], "note": "Design entry point. Run `sh .claude/skills/impeccable/scripts/impeccable context` first; PRODUCT.md and DESIGN.md are authority. Refinement inside Blueprint Press, never a new visual world unprompted.", "summary": "Design command set reading PRODUCT.md/DESIGN.md." },
    "design-guidelines": { "group": "design-core", "phase": 1, "keywords": ["light mode", "dark mode", "theme", "toggle", "design token", "palette", "studio theme", "restyle", "styling", "css"], "note": "Reference tokens only, not the live design system (root DESIGN.md is).", "summary": "Light/dark reference tokens." },
    "web-design-guidelines": { "group": "design-review", "phase": 4, "keywords": ["accessibility", "a11y", "review my ui", "review ux", "best practices", "web interface guidelines", "audit design"], "summary": "Vercel UI guideline compliance review." },
    "design-review": { "group": "design-review", "phase": 4, "keywords": ["design review", "design critique", "qa pass", "visual hierarchy", "review the design", "polish pass", "review what i built"], "note": "Expects a design brief. Without one, prefer impeccable critique.", "summary": "Structured design critique against a brief." },

    "motion-design": { "group": "motion-repo", "phase": 2, "keywords": ["animation", "animate", "motion", "transition", "hover effect", "cursor effect", "scroll effect", "micro-interaction", "svelte-bits", "react-bits", "subtle animations", "smoother", "more alive", "feel polished", "reveal", "parallax", "spring", "easing"], "next": ["motion-fluidity", "motion-layout"], "note": "Authority on WHAT moves and HOW MUCH. Generic animation skills yield to its thresholds.", "summary": "Decide what to animate and how far." },
    "motion-fluidity": { "group": "motion-repo", "phase": 3, "keywords": ["feels janky", "framer-motion", "framer motion", "useScroll", "useSpring", "whileInView", "AnimatePresence", "keyframes", "stagger", "janky", "pops in", "count-up", "marquee", "magnet", "tilt", "blur-in", "text reveal"], "summary": "Implement motion in this codebase's system." },
    "motion-layout": { "group": "motion-repo", "phase": 3, "keywords": ["new section", "add a section", "restructure", "section", "hero", "nav", "navbar", "card grid", "gallery", "tabs", "stepper", "sticky", "feel more designed", "blueprint.css", "bp-shell", "pagespine"], "summary": "Structure/compose sections in the Blueprint Press shell." },

    "animate": { "group": "motion-generic", "phase": 3, "keywords": ["build an animation", "make a transition", "popover animation", "make it feel alive", "enter animation", "exit animation"], "note": "Generic. In this repo it defers to motion-design for taste limits and motion-fluidity for the --ease/EASE/Reveal system.", "summary": "Build an animation decision-first." },
    "review-animations": { "group": "motion-generic", "phase": 4, "keywords": ["review animation", "review the animation", "review motion", "animation review", "is this animation good", "animation code review"], "summary": "Review motion code against an Emil Kowalski bar." },
    "improve-animations": { "group": "motion-generic", "phase": 2, "keywords": ["improve the animations", "audit the motion", "motion audit", "animation audit", "animation roadmap", "audit animations"], "note": "Read-only plan. Cross-check with motion-design inventory.", "summary": "Codebase-wide motion audit and plans." },
    "find-animation-opportunities": { "group": "motion-generic", "phase": 2, "keywords": ["what could be animated", "animation opportunities", "should animate", "where to animate", "make this feel more alive"], "note": "Read-only. Filter proposals through motion-design before building.", "summary": "Find places worth animating." },
    "animation-vocabulary": { "group": "motion-generic", "phase": 1, "keywords": ["what's it called", "what is it called", "whats it called", "name of that animation", "the thing where", "what do you call"], "summary": "Name a described effect." },
    "emil-design-eng": { "group": "motion-generic", "phase": 2, "keywords": ["emil", "kowalski", "ui polish", "invisible details", "feel great"], "summary": "Emil Kowalski UI polish philosophy." },
    "apple-design": { "group": "motion-generic", "phase": 2, "keywords": ["apple", "ios style", "gesture", "drag", "swipe", "sheet", "momentum", "interruptible", "translucent", "rubber-band", "optical sizing"], "summary": "Apple-style fluid, physical interaction." },

    "mobile-native": { "group": "mobile", "phase": 3, "keywords": ["feels native", "100vh", "tap highlight", "notch", "safe area", "pwa", "pull-to-refresh", "works in chrome but", "on my phone", "iphone", "touch", "sticky hover", "zooms"], "summary": "Web-on-phone native-feel fixes." },

    "grill-me": { "group": "planning", "phase": 1, "keywords": ["grill me", "stress-test", "challenge my plan", "poke holes", "interview me"], "summary": "Relentless plan interview." },
    "design-brief": { "group": "planning", "phase": 2, "keywords": ["design brief", "write a brief", "plan a new page", "plan a new feature", "ui direction"], "next": ["information-architecture", "brief-to-tasks"], "summary": "Brief via interview + codebase." },
    "information-architecture": { "group": "planning", "phase": 2, "keywords": ["information architecture", "site structure", "navigation structure", "user flow", "url pattern", "sitemap", "content hierarchy"], "summary": "Structure before visuals." },
    "brief-to-tasks": { "group": "planning", "phase": 2, "keywords": ["break down", "task list from", "tasks from the brief", "implementation order", "vertical slices", "breakdown"], "summary": "Brief into ordered build tasks." },
    "design-flow": { "group": "planning", "phase": 2, "keywords": ["design flow", "full design process", "complete design process", "full workflow"], "gate": "explicit", "note": "Runs design-tokens + frontend-design phases that can drift from Blueprint Press. Only on explicit request; skip the tokens phase here.", "summary": "Guided grill-to-build design sequence." },
    "prototype": { "group": "planning", "phase": 3, "keywords": ["prototype", "variants", "multiple versions", "different versions", "visual picker", "explore options"], "note": "Throwaway variants. Keep outside app/ unless Riley promotes one.", "summary": "Build several UI variants behind a picker." },
    "pick-ui-library": { "group": "planning", "phase": 2, "keywords": ["which library", "what library", "npm package for", "otp input", "command menu", "virtualization", "chart library", "date picker", "pick a library"], "note": "Check package.json first; avoid adding deps casually.", "summary": "Choose a frontend library." },

    "write-commit": { "group": "git", "phase": 5, "keywords": ["commit message", "write the commit", "write a commit", "write commit", "commit summary", "github desktop", "commit description"], "note": "Project copy preferred over anthropic-skills:write-commit. Run vault-sync first if code/data changed.", "summary": "Commit summary for GitHub Desktop." },
    "write-merge": { "group": "git", "phase": 5, "keywords": ["pull request", "pr description", "merge commit", "write merge", "merge into main", "merge description"], "summary": "PR title/body and merge commit text." },

    "full-output-enforcement": { "group": "output", "phase": 3, "keywords": ["full file", "complete file", "entire file", "don't truncate", "no placeholders", "unabridged", "every line", "exhaustive"], "summary": "Ban truncation and placeholders." },

    "frontend-design": { "group": "greenfield-design", "phase": 3, "keywords": ["distinctive", "aesthetic philosophy", "new page from scratch", "frontend design"], "gate": "explicit", "note": "Generic greenfield. This site is refinement inside Blueprint Press; use impeccable instead.", "summary": "Aesthetic-philosophy frontend builder." },
    "design-tokens": { "group": "greenfield-design", "phase": 3, "keywords": ["generate tokens", "tailwind config", "tokens file", "new design system"], "gate": "explicit", "note": "Would duplicate root DESIGN.md / blueprint.css tokens. Use impeccable document/extract.", "summary": "Generate a tokens file." },
    "design-taste-frontend": { "group": "greenfield-design", "phase": 3, "keywords": ["anti-slop", "taste", "templated", "generic ai"], "gate": "explicit", "note": "Anti-slop lens. Usable as a read-only critique lens; must not trigger a redesign.", "summary": "Anti-slop frontend taste (current)." },
    "design-taste-frontend-v1": { "group": "greenfield-design", "phase": 3, "keywords": ["taste v1"], "gate": "explicit", "note": "Frozen; only on explicit request.", "summary": "Frozen v1 taste skill." },
    "gpt-taste": { "group": "greenfield-design", "phase": 3, "keywords": ["gsap", "scrolltrigger", "pinning", "aida"], "gate": "explicit", "note": "Heavy GSAP scroll motion violates 'subtle motion' in PRODUCT.md.", "summary": "GSAP scroll-motion UI engineer." },
    "high-end-visual-design": { "group": "greenfield-design", "phase": 3, "keywords": ["high-end", "agency-grade", "expensive looking", "premium feel"], "gate": "explicit", "note": "Could override the Blueprint Press look. Lens only.", "summary": "Agency-grade visual defaults." },
    "industrial-brutalist-ui": { "group": "greenfield-design", "phase": 3, "keywords": ["brutalist", "swiss", "terminal aesthetic"], "gate": "explicit", "note": "Different visual world; never unprompted.", "summary": "Brutalist Swiss/terminal UI." },
    "minimalist-ui": { "group": "greenfield-design", "phase": 3, "keywords": ["minimalist", "warm monochrome", "bento"], "gate": "explicit", "note": "Different visual world; never unprompted.", "summary": "Editorial minimalism." },
    "redesign-existing-projects": { "group": "greenfield-design", "phase": 3, "keywords": ["redesign", "redesign existing", "upgrade the site", "new look", "new visual world", "generic ai patterns"], "gate": "explicit", "note": "PRODUCT.md forbids replacing the visual world without a direction round. Ask Riley first.", "summary": "Audit and upgrade an existing site." },
    "stitch-design-taste": { "group": "greenfield-design", "phase": 2, "keywords": ["stitch", "google stitch"], "gate": "explicit", "note": "Repo DESIGN.md already exists via impeccable document.", "summary": "Stitch DESIGN.md generator." },

    "brandkit": { "group": "imagegen", "phase": 3, "keywords": ["brand kit", "brand guidelines", "logo system", "identity deck", "brand board"], "gate": "explicit", "note": "Image generation. Only on explicit brand request.", "summary": "Brand-guidelines imagery." },
    "image-to-code": { "group": "imagegen", "phase": 3, "keywords": ["image to code", "from the image", "from a screenshot", "match this design image"], "gate": "explicit", "note": "Generates reference images first; heavy and replacement-oriented.", "summary": "Reference image first, then code." },
    "imagegen-frontend-web": { "group": "imagegen", "phase": 2, "keywords": ["section images", "design reference images", "web comps"], "gate": "explicit", "note": "Image generation only.", "summary": "Per-section web design reference images." },
    "imagegen-frontend-mobile": { "group": "imagegen", "phase": 2, "keywords": ["mobile app screens", "app screen concepts", "phone mockup"], "gate": "explicit", "note": "Image generation only; not relevant to this web site.", "summary": "Mobile app concept images." }
  },
  "rules": [
    { "id": "code-change-vault", "when": "\\b(add|change|update|edit|refactor|rename|implement|fix|build|create|remove|delete|restyle|move)\\b", "skip_when": "\\b(commit message|pr description|just (explain|tell|answer))\\b", "add": ["vault-sync"], "why": "CLAUDE.md: any change to site code, data, or config syncs the vault in the same session." },
    { "id": "ui-edit-context", "when": "\\b(ui|css|styling|component|layout|hero|nav|button|card|font|spacing|animation|motion)\\b", "add": ["impeccable"], "why": "Any UI work reads PRODUCT.md/DESIGN.md through impeccable first." },
    { "id": "motion-first", "when": "\\b(animat\\w*|motion|transition|hover|scroll effect|parallax|spring)\\b", "add": ["motion-design"], "why": "motion-design is the authority on what moves and how much; it precedes any generic motion skill." },
    { "id": "data-edit-sites", "when": "data/(site|projects|experience)|about-site|projects\\.json|experience\\.json", "add": ["site-timeline-sync"], "why": "Meaningful data/site changes feed the About page timeline." },
    { "id": "tracker-edit", "when": "gantt|job application tracker|jobsapplliedto", "add": ["sync-charts"], "why": "Tracker edits must stay identical in README.md and data/more-info/gantt.md." }
  ],
  "chains": [
    { "name": "resume", "steps": ["custom-resume", "grill-my-resume", "fix-my-resume"], "note": "Hand off step to step only when the user asks for the whole route." },
    { "name": "motion", "steps": ["motion-design", "motion-fluidity", "motion-layout"], "note": "decide, implement, compose." },
    { "name": "design-from-zero", "steps": ["grill-me", "design-brief", "information-architecture", "brief-to-tasks", "design-review"], "note": "design-flow minus the tokens/frontend phases that drift from Blueprint Press." },
    { "name": "ship", "steps": ["vault-sync", "write-commit", "write-merge"], "note": "Sync documentation, then draft commit and PR text." }
  ]
}
