node_modules
.next
out
.env*.local
.DS_Store
*.log
*.tsbuildinfo
# Generated by `next dev` / `next build` on every run.
next-env.d.ts

# Scratch space: browser profiles, PDF runtimes, one-off scripts. Never versioned.
tmp/

# Obsidian vault: track the notes and shared config, ignore per-device
# window/pane state so it doesn't churn or conflict across machines.
**/.obsidian/workspace.json
**/.obsidian/workspace-mobile.json

# Personal editor settings; extensions.json (recommendations) stays tracked.
.vscode/settings.json

# Studio keeps a rolling backup of each JSON file it saves — local only.
.studio-backups
# Which devices on the local network may open the dev site, and until when (Studio → Devices).
.studio-access.json
# Resized copies of public/ images for the Studio's thumbnails. Safe to delete; rebuilt on demand.
.studio-cache

# Claude Code: skills are versioned once under .agents/skills/ and this path is a
# per-machine junction to it (see .agents/README.md). Worktrees are checkouts, not source.
.claude/skills
.claude/worktrees

# impeccable live-mode runtime state (the port/token of a running live server); config.json
# beside it is meant to be committed. Critiques are timestamped run outputs.
.impeccable/live/server.json
.impeccable/critique/
